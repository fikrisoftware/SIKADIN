# ==============================================================================
# SI DIKA (Sistem Kasir dan Inventori) - Environment Variables Configuration
# ==============================================================================
# Salin file ini menjadi .env.local untuk konfigurasi development lokal:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (WAJIB JIKA TIDAK MENGGUNAKAN firebase-applet-config.json)
# ------------------------------------------------------------------------------
# Jika variabel di bawah tidak diisi, aplikasi akan menggunakan fallback dari file
# `firebase-applet-config.json`. Untuk production/deployment kustom, sangat
# disarankan mengisi variabel ini.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 2. SI DIKA ONE PAYMENT SYSTEM — SERVER-SIDE ONLY SECRETS (OPSIONAL / LIVE API)
# ------------------------------------------------------------------------------
# JANGAN PERNAH gunakan prefix NEXT_PUBLIC_ untuk variabel di bawah ini!
# Biarkan kosong untuk berjalan dalam mode built-in Sandbox Simulasi.

# Midtrans (Core API / Snap & Iris Disbursement)
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_IRIS_API_KEY=""

# DOKU Jokul (Checkout / Direct API & Payout)
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_IS_PRODUCTION="false"

# Xendit (QRIS / Virtual Account / E-Wallet & Disbursement)
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (OPSIONAL / UNTUK FITUR AI)
# ------------------------------------------------------------------------------
# Digunakan untuk integrasi analitik AI / copywriting pemasaran / asisten pintar.
# Di Google AI Studio / Cloud Run, variabel ini di-inject secara otomatis.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. APPLICATION & HOSTING URL (OPSIONAL)
# ------------------------------------------------------------------------------
# URL publik aplikasi tempat aplikasi di-hosting (misal: https://sidika.kadin.id).
# Digunakan untuk canonical links, OAuth redirect callback, dan referensi metadata.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. NEXT.JS / BUILD ENVIRONMENT (OPSIONAL)
# ------------------------------------------------------------------------------
# Atur ke 'true' untuk mematikan Hot Module Replacement saat pengeditan otomatis
# di lingkungan AI Studio sandbox / CI test.
DISABLE_HMR="false"
