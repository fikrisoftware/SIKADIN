# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# === SI DIKA One Payment System — Server-Side Only Secrets ===
# Never prefix these variables with NEXT_PUBLIC_. Configure in Settings -> Secrets.
# Leave empty to run in built-in Sandbox Simulation mode.

# Midtrans (Core API / Snap & Iris Disbursement)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IRIS_API_KEY=

# DOKU Jokul (Checkout / Direct API & Payout)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false

# Xendit (QRIS / Virtual Account / E-Wallet & Disbursement)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
