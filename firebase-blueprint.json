{
  "entities": {
    "StoreProfile": {
      "title": "StoreProfile",
      "description": "Profil usaha UMKM pemilik akun KADIN DIGI.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Kuliner & F&B", "Fashion & Batik", "Kriya & Kerajinan", "Sembako & Ritel", "Jasa & Layanan", "Lainnya"]
        },
        "phone": {
          "type": "string",
          "maxLength": 25
        },
        "address": {
          "type": "string",
          "maxLength": 250
        },
        "tagline": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "storeName", "category", "phone", "address", "tagline", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Produk dan stok inventori usaha UMKM.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Kuliner", "Minuman", "Fashion", "Kriya", "Sembako", "Jasa"]
        },
        "costPrice": {
          "type": "number"
        },
        "sellPrice": {
          "type": "number"
        },
        "stock": {
          "type": "number"
        },
        "minStock": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 300
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "sku", "name", "category", "costPrice", "sellPrice", "stock", "minStock", "unit", "imageUrl", "isActive", "createdAt", "updatedAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Catatan mutasi stok masuk, keluar, penjualan, dan koreksi.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": ["masuk", "keluar", "penjualan", "koreksi"]
        },
        "delta": {
          "type": "number"
        },
        "stockAfter": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "productId", "productName", "type", "delta", "stockAfter", "note", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Database pelanggan UMKM (mengandung PII, terisolasi per pemilik usaha).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 25
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "segment": {
          "type": "string",
          "enum": ["Reguler", "Setia", "VIP", "Reseller"]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "totalSpent": {
          "type": "number"
        },
        "totalOrders": {
          "type": "number"
        },
        "loyaltyPoints": {
          "type": "number"
        },
        "lastOrderAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "phone", "email", "segment", "notes", "totalSpent", "totalOrders", "loyaltyPoints", "lastOrderAt", "createdAt", "updatedAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Kampanye pemasaran digital dan voucher promo UMKM.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "channel": {
          "type": "string",
          "enum": ["WhatsApp", "Instagram", "TikTok", "Katalog Digital", "Voucher Kasir"]
        },
        "targetSegment": {
          "type": "string",
          "enum": ["Semua", "Reguler", "Setia", "VIP", "Reseller"]
        },
        "promoCode": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^[A-Z0-9_\\-]*$"
        },
        "discountPercent": {
          "type": "number"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "Aktif", "Selesai"]
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "targetCount": {
          "type": "number"
        },
        "redemptions": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "channel", "targetSegment", "promoCode", "discountPercent", "message", "status", "startDate", "endDate", "targetCount", "redemptions", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Transaksi penjualan kasir POS UMKM.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "receiptNo": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "items": {
          "type": "array"
        },
        "itemCount": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "promoCode": {
          "type": "string",
          "maxLength": 24
        },
        "total": {
          "type": "number"
        },
        "totalCost": {
          "type": "number"
        },
        "profit": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Tunai", "QRIS", "Transfer Bank", "E-Wallet"]
        },
        "amountPaid": {
          "type": "number"
        },
        "changeAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Selesai", "Dibatalkan"]
        },
        "saleDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "receiptNo", "customerId", "customerName", "items", "itemCount", "subtotal", "discount", "promoCode", "total", "totalCost", "profit", "paymentMethod", "amountPaid", "changeAmount", "status", "saleDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/stores/{ownerId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Profil usaha UMKM terisolasi per ownerId."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Katalog produk dan stok inventori per ownerId."
    },
    "/stockLogs/{logId}": {
      "schema": { "$ref": "#/entities/StockLog" },
      "description": "Riwayat mutasi stok inventori yang bersifat immutable."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Database pelanggan UMKM (PII terlindungi per ownerId)."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Kampanye pemasaran digital dan voucher promo per ownerId."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Catatan transaksi penjualan kasir POS per ownerId."
    }
  }
}
