{
  "entities": {
    "StoreProfile": {
      "title": "StoreProfile",
      "description": "Profil usaha UMKM yang terdaftar di KADIN DIGI (1 dokumen per pemilik usaha)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Firebase Auth UID pemilik UMKM" },
        "storeName": { "type": "string", "description": "Nama toko atau usaha UMKM" },
        "category": { "type": "string", "description": "Sektor usaha UMKM" },
        "phone": { "type": "string", "description": "Nomor WhatsApp bisnis" },
        "address": { "type": "string", "description": "Alamat gerai usaha" },
        "tagline": { "type": "string", "description": "Slogan singkat untuk struk dan katalog" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "storeName", "category", "phone", "address", "tagline", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Item katalog produk inventori & kasir POS UMKM",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "sku", "name", "category", "costPrice", "sellPrice", "stock", "minStock", "unit", "imageUrl", "isActive", "createdAt", "updatedAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Log audit permanen mutasi keluar/masuk stok inventori",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["masuk", "keluar", "penjualan", "koreksi"] },
        "delta": { "type": "number" },
        "stockAfter": { "type": "number" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "productId", "productName", "type", "delta", "stockAfter", "note", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Database pelanggan CRM beserta akumulasi belanja dan poin loyalitas",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "segment": { "type": "string", "enum": ["Reguler", "Setia", "VIP", "Reseller"] },
        "notes": { "type": "string" },
        "totalSpent": { "type": "number" },
        "totalOrders": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "lastOrderAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "email", "segment", "notes", "totalSpent", "totalOrders", "loyaltyPoints", "lastOrderAt", "createdAt", "updatedAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Kampanye pemasaran digital dan kode voucher diskon terhubung ke kasir",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "channel": { "type": "string" },
        "targetSegment": { "type": "string" },
        "promoCode": { "type": "string" },
        "discountPercent": { "type": "number" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Aktif", "Selesai"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "targetCount": { "type": "number" },
        "redemptions": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "channel", "targetSegment", "promoCode", "discountPercent", "message", "status", "startDate", "endDate", "targetCount", "redemptions", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Transaksi penjualan kasir POS beserta ringkasan HPP dan laba kotor",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "receiptNo": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array" },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "promoCode": { "type": "string" },
        "total": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Tunai", "QRIS", "Transfer Bank", "E-Wallet"] },
        "amountPaid": { "type": "number" },
        "changeAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Selesai", "Dibatalkan"] },
        "saleDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "receiptNo", "customerId", "customerName", "items", "itemCount", "subtotal", "discount", "promoCode", "total", "totalCost", "profit", "paymentMethod", "amountPaid", "changeAmount", "status", "saleDate", "createdAt", "updatedAt"]
    },
    "UserRoleProfile": {
      "title": "UserRoleProfile",
      "description": "Profil identitas peran RBAC 4 tingkat (kasir, pemilik, admin_pusat, super_admin_pusat) dan penempatan ruang kerja toko",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["kasir", "pemilik", "admin_pusat", "super_admin_pusat"] },
        "workspaceOwnerId": { "type": "string" },
        "storeName": { "type": "string" },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif"] },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "workspaceOwnerId", "storeName", "status", "assignedBy", "createdAt", "updatedAt"]
    },
    "RoleInvite": {
      "title": "RoleInvite",
      "description": "Undangan penetapan peran berbasis email Google sebelum pengguna pertama kali masuk",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["kasir", "pemilik", "admin_pusat", "super_admin_pusat"] },
        "workspaceOwnerId": { "type": "string" },
        "storeName": { "type": "string" },
        "status": { "type": "string", "enum": ["Menunggu", "Diterima", "Dicabut"] },
        "invitedByUid": { "type": "string" },
        "invitedByName": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "workspaceOwnerId", "storeName", "status", "invitedByUid", "invitedByName", "note", "createdAt", "updatedAt"]
    },
    "RoleAuditLog": {
      "title": "RoleAuditLog",
      "description": "Audit log permanen setiap perubahan peran, undangan, atau penonaktifan akun RBAC",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["kasir", "pemilik", "admin_pusat", "super_admin_pusat"] },
        "targetEmail": { "type": "string" },
        "targetRole": { "type": "string", "enum": ["kasir", "pemilik", "admin_pusat", "super_admin_pusat"] },
        "workspaceOwnerId": { "type": "string" },
        "action": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorName", "actorRole", "targetEmail", "targetRole", "workspaceOwnerId", "action", "note", "createdAt"]
    }
  },
  "firestore": {
    "/stores/{ownerId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Profil usaha UMKM per pemilik; diakses oleh pemilik, kasir terdaftar, dan kantor pusat KADIN"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Katalog produk inventori & kasir UMKM"
    },
    "/stockLogs/{logId}": {
      "schema": { "$ref": "#/entities/StockLog" },
      "description": "Riwayat mutasi stok inventori (immutable)"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Database pelanggan CRM per usaha UMKM"
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Kampanye pemasaran digital & kode voucher"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Riwayat transaksi penjualan kasir POS"
    },
    "/userRoles/{uid}": {
      "schema": { "$ref": "#/entities/UserRoleProfile" },
      "description": "Profil peran RBAC 4 tingkat tiap akun Google terautentikasi"
    },
    "/roleInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/RoleInvite" },
      "description": "Undangan penetapan peran berbasis email Google"
    },
    "/roleAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/RoleAuditLog" },
      "description": "Log audit permanen perubahan hak akses dan peran"
    }
  }
}
