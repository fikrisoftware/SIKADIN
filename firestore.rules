rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // === Global Hardened Primitives & 4-Tier RBAC Identity ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwnerId(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Bootstrapped Root Super Admin Kantor Pusat (Email Verified Mandatory)
    function isBootstrapSuperAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'recehanfikri@gmail.com';
    }

    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }

    function isActiveRole() {
      return hasRoleDoc() && roleDoc().status == 'Aktif';
    }

    function isSuperAdminPusat() {
      return isBootstrapSuperAdmin()
        || (isVerifiedUser() && isActiveRole() && roleDoc().role == 'super_admin_pusat');
    }

    function isAdminPusat() {
      return isVerifiedUser() && isActiveRole() && roleDoc().role == 'admin_pusat';
    }

    function isHqAdmin() {
      return isSuperAdminPusat() || isAdminPusat();
    }

    function isAssignedCashierOf(storeOwnerId) {
      return isVerifiedUser()
        && isActiveRole()
        && roleDoc().role == 'kasir'
        && roleDoc().workspaceOwnerId == storeOwnerId;
    }

    function isActiveStoreOwner(storeOwnerId) {
      return isOwnerId(storeOwnerId)
        && (!hasRoleDoc() || (roleDoc().status == 'Aktif' && roleDoc().role != 'kasir'));
    }

    function canManageStore(storeOwnerId) {
      return isActiveStoreOwner(storeOwnerId) || isHqAdmin();
    }

    function canOperateStore(storeOwnerId) {
      return canManageStore(storeOwnerId) || isAssignedCashierOf(storeOwnerId);
    }

    function myEmailLower() {
      return request.auth.token.email.lower();
    }

    function myInviteId() {
      return 'inv_' + myEmailLower().replace('@', '_at_').replace('\\.', '_dot_').replace('[^a-z0-9_\\-]', '_');
    }

    function myInvitePath() {
      return /databases/$(database)/documents/roleInvites/$(myInviteId());
    }

    // === Entity Validation Blueprints (Anti-Update-Gap) ===

    function isValidStoreProfile(data) {
      return data.keys().hasAll(['ownerId', 'storeName', 'category', 'phone', 'address', 'tagline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'storeName', 'category', 'phone', 'address', 'tagline', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.category in ['Kuliner & F&B', 'Fashion & Batik', 'Kriya & Kerajinan', 'Sembako & Ritel', 'Jasa & Layanan', 'Lainnya']
        && data.phone is string && data.phone.size() <= 25
        && data.address is string && data.address.size() <= 250
        && data.tagline is string && data.tagline.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['ownerId', 'sku', 'name', 'category', 'costPrice', 'sellPrice', 'stock', 'minStock', 'unit', 'imageUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'sku', 'name', 'category', 'costPrice', 'sellPrice', 'stock', 'minStock', 'unit', 'imageUrl', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 40 && data.sku.matches('^[a-zA-Z0-9_\\-\\.]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 30
        && data.category in ['Kuliner', 'Minuman', 'Fashion', 'Kriya', 'Sembako', 'Jasa']
        && data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 1000000000
        && data.sellPrice is number && data.sellPrice >= 0 && data.sellPrice <= 1000000000
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.minStock is number && data.minStock >= 0 && data.minStock <= 100000
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && data.imageUrl is string && data.imageUrl.size() <= 300
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockLog(data) {
      return data.keys().hasAll(['ownerId', 'productId', 'productName', 'type', 'delta', 'stockAfter', 'note', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'productId', 'productName', 'type', 'delta', 'stockAfter', 'note', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 20
        && data.type in ['masuk', 'keluar', 'penjualan', 'koreksi']
        && data.delta is number && data.delta >= -100000 && data.delta <= 100000
        && data.stockAfter is number && data.stockAfter >= 0 && data.stockAfter <= 1000000
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'email', 'segment', 'notes', 'totalSpent', 'totalOrders', 'loyaltyPoints', 'lastOrderAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'phone', 'email', 'segment', 'notes', 'totalSpent', 'totalOrders', 'loyaltyPoints', 'lastOrderAt', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 25
        && data.email is string && data.email.size() <= 120
        && data.segment is string && data.segment.size() >= 1 && data.segment.size() <= 20
        && data.segment in ['Reguler', 'Setia', 'VIP', 'Reseller']
        && data.notes is string && data.notes.size() <= 300
        && data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 10000000000
        && data.totalOrders is number && data.totalOrders >= 0 && data.totalOrders <= 1000000
        && data.loyaltyPoints is number && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 10000000
        && data.lastOrderAt is string && data.lastOrderAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['ownerId', 'title', 'channel', 'targetSegment', 'promoCode', 'discountPercent', 'message', 'status', 'startDate', 'endDate', 'targetCount', 'redemptions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'channel', 'targetSegment', 'promoCode', 'discountPercent', 'message', 'status', 'startDate', 'endDate', 'targetCount', 'redemptions', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.channel is string && data.channel.size() >= 1 && data.channel.size() <= 30
        && data.channel in ['WhatsApp', 'Instagram', 'TikTok', 'Katalog Digital', 'Voucher Kasir']
        && data.targetSegment is string && data.targetSegment.size() >= 1 && data.targetSegment.size() <= 20
        && data.targetSegment in ['Semua', 'Reguler', 'Setia', 'VIP', 'Reseller']
        && data.promoCode is string && data.promoCode.size() <= 24 && data.promoCode.matches('^[A-Z0-9_\\-]*$')
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 90
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 20
        && data.status in ['Draft', 'Aktif', 'Selesai']
        && data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 20 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDate is string && data.endDate.size() >= 10 && data.endDate.size() <= 20 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.targetCount is number && data.targetCount >= 0 && data.targetCount <= 1000000
        && data.redemptions is number && data.redemptions >= 0 && data.redemptions <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransactionItem(item) {
      return item is map
        && item.keys().hasAll(['productId', 'sku', 'name', 'category', 'qty', 'sellPrice', 'costPrice', 'subtotal'])
        && item.keys().hasOnly(['productId', 'sku', 'name', 'category', 'qty', 'sellPrice', 'costPrice', 'subtotal'])
        && isValidId(item.productId)
        && item.sku is string && item.sku.size() >= 1 && item.sku.size() <= 40
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 120
        && item.category is string && item.category.size() >= 1 && item.category.size() <= 30
        && item.qty is number && item.qty >= 1 && item.qty <= 1000
        && item.sellPrice is number && item.sellPrice >= 0 && item.sellPrice <= 1000000000
        && item.costPrice is number && item.costPrice >= 0 && item.costPrice <= 1000000000
        && item.subtotal is number && item.subtotal >= 0 && item.subtotal <= 1000000000;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'receiptNo', 'customerId', 'customerName', 'items', 'itemCount', 'subtotal', 'discount', 'promoCode', 'total', 'totalCost', 'profit', 'paymentMethod', 'amountPaid', 'changeAmount', 'status', 'saleDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'receiptNo', 'customerId', 'customerName', 'items', 'itemCount', 'subtotal', 'discount', 'promoCode', 'total', 'totalCost', 'profit', 'paymentMethod', 'amountPaid', 'changeAmount', 'status', 'saleDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.receiptNo is string && data.receiptNo.size() >= 4 && data.receiptNo.size() <= 40 && data.receiptNo.matches('^[A-Z0-9_\\-]+$')
        && data.customerId is string && data.customerId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && isValidTransactionItem(data.items[0])
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 1000
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000000
        && data.discount is number && data.discount >= 0 && data.discount <= 1000000000
        && data.promoCode is string && data.promoCode.size() <= 24
        && data.total is number && data.total >= 0 && data.total <= 1000000000
        && data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 1000000000
        && data.profit is number && data.profit >= -1000000000 && data.profit <= 1000000000
        && data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 30
        && data.paymentMethod in ['Tunai', 'QRIS', 'Transfer Bank', 'E-Wallet']
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 1000000000
        && data.changeAmount is number && data.changeAmount >= 0 && data.changeAmount <= 1000000000
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 20
        && data.status in ['Selesai', 'Dibatalkan']
        && data.saleDate is string && data.saleDate.size() >= 10 && data.saleDate.size() <= 20 && data.saleDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserRoleProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'workspaceOwnerId', 'storeName', 'status', 'assignedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'workspaceOwnerId', 'storeName', 'status', 'assignedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['kasir', 'pemilik', 'admin_pusat', 'super_admin_pusat']
        && isValidId(data.workspaceOwnerId)
        && data.storeName is string && data.storeName.size() <= 120
        && data.status is string && data.status in ['Aktif', 'Nonaktif']
        && data.assignedBy is string && data.assignedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoleInvite(data) {
      return data.keys().hasAll(['email', 'role', 'workspaceOwnerId', 'storeName', 'status', 'invitedByUid', 'invitedByName', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'role', 'workspaceOwnerId', 'storeName', 'status', 'invitedByUid', 'invitedByName', 'note', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.role is string && data.role in ['kasir', 'pemilik', 'admin_pusat', 'super_admin_pusat']
        && isValidId(data.workspaceOwnerId)
        && data.storeName is string && data.storeName.size() <= 120
        && data.status is string && data.status in ['Menunggu', 'Diterima', 'Dicabut']
        && isValidId(data.invitedByUid)
        && data.invitedByName is string && data.invitedByName.size() >= 1 && data.invitedByName.size() <= 120
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoleAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'actorRole', 'targetEmail', 'targetRole', 'workspaceOwnerId', 'action', 'note', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'targetEmail', 'targetRole', 'workspaceOwnerId', 'action', 'note', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole in ['kasir', 'pemilik', 'admin_pusat', 'super_admin_pusat']
        && data.targetEmail is string && data.targetEmail.size() >= 3 && data.targetEmail.size() <= 120
        && data.targetRole is string && data.targetRole in ['kasir', 'pemilik', 'admin_pusat', 'super_admin_pusat']
        && isValidId(data.workspaceOwnerId)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.note is string && data.note.size() <= 240
        && data.createdAt is timestamp;
    }

    // === Collection Rules ===

    // 1. Store Profile (Contains PII: phone, address)
    match /stores/{ownerId} {
      allow get: if isValidId(ownerId) && canOperateStore(ownerId);
      allow list: if isHqAdmin();
      allow create: if isValidId(ownerId)
        && isValidStoreProfile(incoming())
        && incoming().ownerId == ownerId
        && canManageStore(ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ownerId)
        && isValidStoreProfile(incoming())
        && canManageStore(ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'category', 'phone', 'address', 'tagline', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Products / Inventory
    match /products/{productId} {
      allow get: if isValidId(productId) && canOperateStore(existing().ownerId);
      allow list: if canOperateStore(existing().ownerId);
      allow create: if isValidId(productId)
        && isValidProduct(incoming())
        && canManageStore(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Pemilik / HQ Admin full product & stock edits
          (canManageStore(existing().ownerId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['sku', 'name', 'category', 'costPrice', 'sellPrice', 'stock', 'minStock', 'unit', 'imageUrl', 'isActive', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
          )) ||
          // Tier 2: Kasir can ONLY decrement stock during POS checkout
          (isAssignedCashierOf(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && incoming().stock < existing().stock)
        );
      allow delete: if isValidId(productId) && canManageStore(existing().ownerId);
    }

    // 3. Stock Logs (Immutable Audit Log)
    match /stockLogs/{logId} {
      allow get: if isValidId(logId) && canOperateStore(existing().ownerId);
      allow list: if canOperateStore(existing().ownerId);
      allow create: if isValidId(logId)
        && isValidStockLog(incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().productId))
        && get(/databases/$(database)/documents/products/$(incoming().productId)).data.ownerId == incoming().ownerId
        && (
          canManageStore(incoming().ownerId) ||
          (isAssignedCashierOf(incoming().ownerId) && incoming().type == 'penjualan' && incoming().delta < 0)
        );
      allow update: if false;
      allow delete: if false;
    }

    // 4. Customers (Contains PII: phone, email — Strictly Scoped by Store Role / HQ)
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && canOperateStore(existing().ownerId);
      allow list: if canOperateStore(existing().ownerId);
      allow create: if isValidId(customerId)
        && isValidCustomer(incoming())
        && canOperateStore(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Pemilik / HQ Admin full customer profile or stats edit
          (canManageStore(existing().ownerId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'segment', 'notes', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['totalSpent', 'totalOrders', 'loyaltyPoints', 'lastOrderAt', 'segment', 'updatedAt'])
          )) ||
          // Tier 2: Kasir can ONLY update purchase stats & loyalty on POS checkout
          (isAssignedCashierOf(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['totalSpent', 'totalOrders', 'loyaltyPoints', 'lastOrderAt', 'segment', 'updatedAt']))
        );
      allow delete: if isValidId(customerId) && canManageStore(existing().ownerId);
    }

    // 5. Digital Marketing Campaigns & Vouchers
    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && canOperateStore(existing().ownerId);
      allow list: if canOperateStore(existing().ownerId);
      allow create: if isValidId(campaignId)
        && isValidCampaign(incoming())
        && canManageStore(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(campaignId)
        && isValidCampaign(incoming())
        && existing().status != 'Selesai'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Pemilik / HQ Admin campaign management
          (canManageStore(existing().ownerId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'channel', 'targetSegment', 'promoCode', 'discountPercent', 'message', 'status', 'startDate', 'endDate', 'targetCount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['redemptions', 'updatedAt']) && incoming().redemptions == existing().redemptions + 1)
          )) ||
          // Tier 2: Kasir can ONLY increment voucher redemptions on POS checkout
          (isAssignedCashierOf(existing().ownerId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['redemptions', 'updatedAt'])
            && incoming().redemptions == existing().redemptions + 1)
        );
      allow delete: if isValidId(campaignId) && canManageStore(existing().ownerId);
    }

    // 6. POS Transactions (Kasir can create sales, ONLY Pemilik / HQ Admin can void/cancel)
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && canOperateStore(existing().ownerId);
      allow list: if canOperateStore(existing().ownerId);
      allow create: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && canOperateStore(incoming().ownerId)
        && incoming().status == 'Selesai'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().customerId == '' ||
          (
            isValidId(incoming().customerId)
            && exists(/databases/$(database)/documents/customers/$(incoming().customerId))
            && get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.ownerId == incoming().ownerId
          )
        );
      allow update: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && canManageStore(existing().ownerId)
        && existing().status == 'Selesai'
        && incoming().status == 'Dibatalkan'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // 7. RBAC User Role Profiles (Zero Self-Escalation — PII Isolated)
    match /userRoles/{targetUid} {
      allow get: if isValidId(targetUid)
        && (isOwnerId(targetUid) || existing().workspaceOwnerId == request.auth.uid || isHqAdmin());
      allow list: if isVerifiedUser()
        && (existing().workspaceOwnerId == request.auth.uid || isHqAdmin());
      allow create: if isVerifiedUser()
        && isValidId(targetUid)
        && targetUid == request.auth.uid
        && isValidUserRoleProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == myEmailLower()
        && incoming().status == 'Aktif'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Bootstrapped Super Admin Kantor Pusat
          (isBootstrapSuperAdmin() && incoming().role == 'super_admin_pusat' && incoming().workspaceOwnerId == request.auth.uid) ||
          // Claiming an active trusted invitation created by an authorized manager/admin
          (exists(myInvitePath())
            && get(myInvitePath()).data.status == 'Menunggu'
            && get(myInvitePath()).data.email == myEmailLower()
            && incoming().role == get(myInvitePath()).data.role
            && incoming().workspaceOwnerId == get(myInvitePath()).data.workspaceOwnerId) ||
          // Standard UMKM merchant self-registration (strictly restricted to own pemilik workspace)
          (incoming().role == 'pemilik' && incoming().workspaceOwnerId == request.auth.uid)
        );
      allow update: if isVerifiedUser()
        && isValidId(targetUid)
        && isValidUserRoleProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Self: Display name sync only (NEVER role, status, or workspace)
          (isOwnerId(targetUid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
          // Pemilik: Can ONLY activate/deactivate kasir staff assigned to their own store
          (isActiveStoreOwner(existing().workspaceOwnerId)
            && existing().role == 'kasir'
            && targetUid != request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedBy', 'updatedAt'])) ||
          // Admin Kantor Pusat: Can manage kasir & pemilik roles/status (NEVER elevate to HQ or modify HQ admins)
          (isAdminPusat()
            && existing().role in ['kasir', 'pemilik']
            && incoming().role in ['kasir', 'pemilik']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'workspaceOwnerId', 'storeName', 'status', 'assignedBy', 'updatedAt'])) ||
          // Super Admin Kantor Pusat: Full 4-tier RBAC authority
          (isSuperAdminPusat()
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'workspaceOwnerId', 'storeName', 'status', 'assignedBy', 'updatedAt']))
        );
      allow delete: if false;
    }

    // 8. RBAC Role Invitations (Pre-Login Role Assignment by Email)
    match /roleInvites/{inviteId} {
      allow get: if isVerifiedUser()
        && isValidId(inviteId)
        && (
          inviteId == myInviteId() ||
          (resource != null && existing().email == myEmailLower()) ||
          (resource != null && existing().workspaceOwnerId == request.auth.uid) ||
          isHqAdmin()
        );
      allow list: if isVerifiedUser()
        && (existing().workspaceOwnerId == request.auth.uid || isHqAdmin());
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidRoleInvite(incoming())
        && incoming().invitedByUid == request.auth.uid
        && incoming().status == 'Menunggu'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Pemilik can ONLY invite Kasir to their own store
          (isActiveStoreOwner(incoming().workspaceOwnerId) && incoming().role == 'kasir') ||
          // Admin Kantor Pusat can invite Kasir or Pemilik
          (isAdminPusat() && incoming().role in ['kasir', 'pemilik']) ||
          // Super Admin Kantor Pusat can invite any of the 4 roles
          isSuperAdminPusat()
        );
      allow update: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidRoleInvite(incoming())
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Invited user claims pending invite upon first login
          (existing().email == myEmailLower()
            && existing().status == 'Menunggu'
            && incoming().status == 'Diterima'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Pemilik revokes or re-issues kasir invite for own store
          (isActiveStoreOwner(existing().workspaceOwnerId)
            && existing().role == 'kasir'
            && incoming().role == 'kasir'
            && incoming().workspaceOwnerId == existing().workspaceOwnerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'storeName', 'note', 'invitedByUid', 'invitedByName', 'updatedAt'])) ||
          // Admin Kantor Pusat updates/revokes kasir/pemilik invites
          (isAdminPusat()
            && existing().role in ['kasir', 'pemilik']
            && incoming().role in ['kasir', 'pemilik']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'workspaceOwnerId', 'storeName', 'status', 'note', 'invitedByUid', 'invitedByName', 'updatedAt'])) ||
          // Super Admin Kantor Pusat full invite management
          (isSuperAdminPusat()
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'workspaceOwnerId', 'storeName', 'status', 'note', 'invitedByUid', 'invitedByName', 'updatedAt']))
        );
      allow delete: if false;
    }

    // 9. Immutable RBAC Audit Logs
    match /roleAuditLogs/{logId} {
      allow get: if isVerifiedUser()
        && isValidId(logId)
        && (existing().workspaceOwnerId == request.auth.uid || isHqAdmin());
      allow list: if isVerifiedUser()
        && (existing().workspaceOwnerId == request.auth.uid || isHqAdmin());
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidRoleAuditLog(incoming())
        && incoming().createdAt == request.time
        && (
          isActiveStoreOwner(incoming().workspaceOwnerId) ||
          isHqAdmin()
        );
      allow update: if false;
      allow delete: if false;
    }
  }
}
